local target='get_hidden_item'
setup()
local found=false
local n=call(find('Steamworks','SteamUserStats','GetNumAchievements',''))
for i=0,n-1 do
 if call(find('Steamworks','SteamUserStats','GetAchievementName','System.UInt32'),0,{i})==target then found=true end
end
assert(found,'Requested Steam achievement not found: '..target)
local ok=call(find('Steamworks','SteamUserStats','SetAchievement','System.String'),0,{target})
assert(ok==true or ok==1,'Steam rejected achievement request: '..target)
local stored=call(find('Steamworks','SteamUserStats','StoreStats',''))
assert(stored==true or stored==1,'Steam rejected stats upload; retry when Steam is connected')
local c=mono_findClass('Last.Management','SteamSDKManager');local sdk
while c and c~=0 and not sdk do
 for _,m in ipairs(mono_class_enumMethods(c)) do if m.name=='get_Instance' then sdk=call(m.method) end end
 c=mono_class_getParent(c)
end
assert(sdk and sdk~=0,'Steam SDK instance unavailable for verification')
local data=g(sdk,'GetAllAchievementsOnPlatform')
assert(g(data,'get_Item',{target})==1,'Achievement readback failed: '..target)
print('ACHIEVEMENT VERIFIED: '..target..'; Steam upload requested')

