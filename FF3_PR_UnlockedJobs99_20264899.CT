<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"全員已解鎖職業熟練度99（地圖上執行一次）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local function find(ns,cls,name,signature)
 local c=mono_findClass(ns,cls)
 assert(c and c~=0,'Class missing: '..cls)
 for _,m in ipairs(mono_class_enumMethods(c)) do
  if m.name==name and (not signature or mono_method_getSignature(m.method)==signature) then return m.method end
 end
 error('Method missing: '..cls..'.'..name)
end
local function call(m,obj,args)
 local r,e=mono_invoke_method(0,m,obj or 0,args or {})
 assert(e==nil,tostring(e))
 return r
end
local function instance(ns,cls)
 local c=mono_findClass(ns,cls)
 local obj=mono_object_new(c)
 assert(obj and obj~=0,'Cannot create '..cls)
 call(find(ns,cls,'.ctor',''),obj)
 return obj
end
local function setup()
 assert(getOpenedProcessID()~=0,'Attach to FINAL FANTASY III.exe first')
 local base=getAddressSafe('GameAssembly.dll')
 assert(base,'FF3 GameAssembly.dll missing')
 local pe=base+readInteger(base+60)
 assert(readInteger(pe+8)==1738594894 and readInteger(pe+80)==39026688,'This CT requires FF3 PR Steam build 20264899')
 assert(LaunchMonoDataCollector(),'Mono collector unavailable')
 local manager=call(find('Last.Management','UserDataManager','Instance',''))
 assert(manager and manager~=0,'Load your save and stop on the map first')
 return manager
end

local function method(o,n)
 local c=mono_object_getClass(o)
 while c and c~=0 do
  for _,v in ipairs(mono_class_enumMethods(c)) do if v.name==n then return v.method end end
  c=mono_class_getParent(c)
 end
 error('Missing method '..n)
end
local function g(o,n,args)return call(method(o,n),o,args) end
local u=setup()
local members={}
for i=0,3 do local ch=g(u,'GetMemberData',{i});assert(ch and ch~=0,'Four party members required');members[#members+1]=ch end

-- Learning uses Content IDs; AddAbility requires master Ability IDs.
local bardLessons={{10,358,108},{20,359,109},{30,361,111}}
local client=instance('Last.Management','OwnedCharacterClient')
local addAbility=find('Last.Management','OwnedCharacterClient','AddAbility','System.Int32,System.Int32')
local function bardLevel(ch,allowed)
 if not allowed[19] then return 0 end
 local jobs=g(ch,'get_OwnedJobDataList')
 for i=0,g(jobs,'get_Count')-1 do local job=g(jobs,'get_Item',{i});if g(job,'get_Id')==19 then return g(job,'get_Level') end end
 return 0
end
local function ownedCounts(ch)
 local list=g(ch,'get_OwnedAbilityList');local counts={}
 for i=0,g(list,'get_Count')-1 do
  local id=g(g(g(list,'get_Item',{i}),'get_Content'),'get_Id')
  counts[id]=(counts[id] or 0)+1
 end
 return counts
end
local function syncBard(ch,allowed)
 local level=bardLevel(ch,allowed);local present=ownedCounts(ch);local added=0
 for _,lesson in ipairs(bardLessons) do
  if level&gt;=lesson[1] and not present[lesson[2]] then
   local a=call(addAbility,client,{g(ch,'get_Id'),lesson[3]})
   assert(a and a~=0,'AddAbility failed for Bard song '..lesson[2])
   assert(g(g(a,'get_Content'),'get_Id')==lesson[2],'Unexpected Bard song returned')
   added=added+1
  end
 end
 return added
end
local function verifyBard(ch,allowed)
 local level=bardLevel(ch,allowed);local owned=ownedCounts(ch)
 local learned=g(ch,'get_LearningAbilitys');local counts={}
 for i=0,g(learned,'get_Count')-1 do local id=g(learned,'get_Item',{i});counts[id]=(counts[id] or 0)+1 end
 for _,v in ipairs(bardLessons) do if level&gt;=v[1] then
  assert(owned[v[2]]==1,'Missing or duplicate owned Bard song '..v[2])
  assert(counts[v[2]] and counts[v[2]]&gt;=1,'Missing learned Bard song '..v[2])
 end end
 print('Character '..g(ch,'get_Id')..': Bard owned songs verified at job level '..level)
end
local original={}
for i,ch in ipairs(members) do original[i]={job=g(ch,'get_JobId'),level=g(g(ch,'get_Parameter'),'ConfirmedLevel'),abilities=ownedCounts(ch)} end

local function released()
 local list=g(u,'get_ReleasedJobs');local ids={};local ordered={}
 for i=0,g(list,'get_Count')-1 do local id=g(g(list,'get_Item',{i}),'get_Id');ids[id]=true;ordered[#ordered+1]=id end
 table.sort(ordered);return ids,table.concat(ordered,',')
end
local allowed,before=released()
for _,ch in ipairs(members) do
 local jobid=g(ch,'get_JobId');local charlevel=g(g(ch,'get_Parameter'),'ConfirmedLevel')
 local list=g(ch,'get_OwnedJobDataList');local n=0
 for i=0,g(list,'get_Count')-1 do
  local job=g(list,'get_Item',{i});local id=g(job,'get_Id')
  if allowed[id] then
   g(job,'set_CurrentProficiency',{9702});g(job,'set_Level',{99})
   assert(g(job,'get_Level')==99 and g(job,'get_CurrentProficiency')==9702,'Job verification failed')
   n=n+1
  end
 end
 g(ch,'set_OwnedJobDataList',{list})
 g(client,'SetOwnedCharacter',{ch})
 -- Persist job changes before AddAbility; never write the stale character back afterward.
 local songs=syncBard(ch,allowed)
 print('Bard songs added: '..songs)
 assert(g(ch,'get_JobId')==jobid and g(g(ch,'get_Parameter'),'ConfirmedLevel')==charlevel,'Character state changed')
 print('Character '..g(ch,'get_Id')..': '..n..' unlocked jobs verified at 99')
end
for i=0,3 do
 local fresh=g(u,'GetMemberData',{i});verifyBard(fresh,allowed)
 local prev=original[i+1];local now=ownedCounts(fresh)
 assert(g(fresh,'get_JobId')==prev.job and g(g(fresh,'get_Parameter'),'ConfirmedLevel')==prev.level,'Fresh character state changed')
 for id,count in pairs(prev.abilities) do assert(now[id]==count,'Existing ability changed: '..id) end
 local list=g(fresh,'get_OwnedJobDataList')
 for j=0,g(list,'get_Count')-1 do local job=g(list,'get_Item',{j});if allowed[g(job,'get_Id')] then assert(g(job,'get_Level')==99 and g(job,'get_CurrentProficiency')==9702,'Fresh job verification failed') end end
end
local _,after=released();assert(before==after,'Unlocked jobs changed')
print('JOBS99 VERIFIED; unlocked IDs unchanged: '..after)

{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
</CheatTable>